# ─── Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Special characters like @ in the password are fine; the app URL-encodes them.

# ─── Alpha Vantage API ──────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_api_key_here

# ─── Pipeline Config ────────────────────────────────────
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,META,TSLA,NVDA,JPM
RAW_DATA_DIR=raw_data
# yfinance (dev, unlimited) | alphavantage (official API requirement)
DATA_SOURCE=yfinance
ALPHA_VANTAGE_OUTPUT_SIZE=compact
LOG_LEVEL=INFO
MAX_RETRIES=3
HTTP_TIMEOUT_SECONDS=30

# ─── Airflow ────────────────────────────────────────────
AIRFLOW__CORE__LOAD_EXAMPLES=False
